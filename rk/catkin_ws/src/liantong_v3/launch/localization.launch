<launch>
  <arg name="port"/>
  <arg name="map_yaml"/>
  <arg name="enable_motion" default="false"/>
  <arg name="start_rviz" default="false"/>
  <arg name="cmd_timeout_s" default="0.3"/>
  <arg name="scan_topic" default="/lidar1/laser_fan"/>
  <arg name="laser_x" default="0.13"/>
  <arg name="laser_y" default="0.0"/>
  <arg name="laser_z" default="0.20"/>
  <arg name="laser_yaw" default="0.0"/>
  <arg name="min_usable_range" default="1.0"/>

  <node pkg="liantong_v3" type="bridge_node.py" name="liantong_v3_bridge" required="true" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="enable_motion" value="$(arg enable_motion)" type="bool"/>
    <param name="cmd_timeout_s" value="$(arg cmd_timeout_s)" type="double"/>
  </node>
  <node pkg="liantong_v3" type="scan_node.py" name="liantong_v3_scan" required="true" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="laser_x" value="$(arg laser_x)" type="double"/>
    <param name="laser_y" value="$(arg laser_y)" type="double"/>
    <param name="laser_z" value="$(arg laser_z)" type="double"/>
    <param name="laser_yaw" value="$(arg laser_yaw)" type="double"/>
    <param name="min_usable_range" value="$(arg min_usable_range)" type="double"/>
  </node>
  <node pkg="map_server" type="map_server" name="map_server" args="&quot;$(arg map_yaml)&quot;"
        required="true" output="screen"/>
  <node pkg="amcl" type="amcl" name="amcl" required="true" output="screen">
    <rosparam command="load" file="$(find liantong_v3)/config/amcl.yaml"/>
    <remap from="scan" to="/scan"/>
    <remap from="initialpose" to="/initialpose"/>
  </node>
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find liantong_v3)/config/localization.rviz"/>
</launch>
