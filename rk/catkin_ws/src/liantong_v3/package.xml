<?xml version="1.0"?>
<package format="2">
  <name>liantong_v3</name>
  <version>0.1.0</version>
  <description>Liantong V3 serial odometry, lidar relay and ROS Noetic localization.</description>
  <maintainer email="robot@example.invalid">Liantong robot project</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>rviz</exec_depend>
  <export/>
</package>
